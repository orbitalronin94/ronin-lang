system MarkovSaturado = {
    parts: 8,
    resource: 1.0,
    agents: [ /* estados con frecuencias */ ],
    params: {
        model: "hill",
        K: 0.5,
        alpha_h: 1.5,
        alpha: 1.0,
        gamma: 0.2,
        sigma: 0.1
    }
}

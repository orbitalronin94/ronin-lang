// Ejemplo 121 de RONIN 1.1 — extracto del documento maestro.
// Se conserva el bloque system; los comandos externos al bloque no forman parte
// del subconjunto que acepta actualmente el parser Python.
system NeuralScaling = {
    parts: 46,
    resource: 1.0,
    agents: [ // Hoffmann et al. 2022 ],
    params: {
        model: "ces_hill",
        lambda: 0.5,
        K: 1.0,
        alpha_h: 1.5,
        degeneracy_check: true
    }
}

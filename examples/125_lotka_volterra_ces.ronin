// Ejemplo 125 de RONIN 1.1 — extracto del documento maestro.
// Se conserva el bloque system; los comandos externos al bloque no forman parte
// del subconjunto que acepta actualmente el parser Python.
system LotkaCES = {
    parts: 5,
    resource: 1000,
    agents: [ // especies con nichos ],
    params: {
        model: "ces",
        lambda: 0.7,
        alpha: 1.3,
        gamma: 0.5,
        sigma: 0.15
    }
}

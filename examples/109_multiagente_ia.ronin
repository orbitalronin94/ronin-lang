// Ejemplo 109 de RONIN 1.1 — extracto del documento maestro.
// Se conserva la declaración system del ejemplo fuente; las instrucciones
// posteriores (solve/diagnose/print/loops) no pertenecen al parser de la CLI actual.
system AtencionCliente = {
    parts: 3,
    resource: 100,
    agents: [
        { name: "Soporte", phi: 0.8, psi: 0.9, frequency: 0.33 },
        { name: "Ventas", phi: 0.7, psi: 0.8, frequency: 0.33 },
        { name: "Tecnico", phi: 0.9, psi: 0.7, frequency: 0.33 }
    ],
    params: { model: "ces", lambda: 0.4, alpha: 1.1, gamma: 0.3, sigma: 0.1 }
}
